# Uploaded files are served as static images only — never executed.
Options -Indexes
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh|shtml|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
